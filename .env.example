# ============================================================================

# Knowledge Assistant Environment

# Copy this file to ".env" and edit locally.

# Do NOT commit your .env file.

# ============================================================================

# Ollama

OLLAMA_HOST=http://localhost:11434

# Optional future providers

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=

# Application

KA_ENVIRONMENT=development

# Logging

KA_LOG_LEVEL=INFO

# Optional future storage

QDRANT_HOST=
QDRANT_PORT=6333

# Optional future NAS connection

NAS_HOST=
NAS_USERNAME=
NAS_PASSWORD=
